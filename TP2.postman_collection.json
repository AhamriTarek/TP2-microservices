                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8081/etudiants",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "etudiants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Sara\",\n  \"email\": \"sara@u.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"id généré\", function () { pm.expect(pm.response.json().id).to.be.a(\"number\"); });"
